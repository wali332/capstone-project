{
  "manifest_version": 3,
  "name": "VoiceGuard",
  "version": "0.5.0",
  "description": "Detect AI-generated speech in browser tab audio using the VoiceGuard backend.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VoiceGuard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabCapture", "offscreen", "activeTab"],
  "host_permissions": ["http://localhost:8000/*"]
}
